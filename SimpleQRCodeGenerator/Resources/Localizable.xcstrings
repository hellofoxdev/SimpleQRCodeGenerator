        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hier findest du die Texte von bis zu 100 deiner letzten gespeicherten QR Codes. Wähle einen aus und erstelle dir ein neues Bild davon in deiner 'Fotos' App. Du kannst (natürlich) auch einzelne Einträge löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here you find the texts of up to 100 of your most recently saved QR codes. Select a code and create a new image of in in your 'Photos' app. You can (of course) also delete individual entries."
          }
        }
