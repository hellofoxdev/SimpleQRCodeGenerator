    "contactText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei Fragen und Anregungen, schickt mir ne E-Mail"
          }
        },
