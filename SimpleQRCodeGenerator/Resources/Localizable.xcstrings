    "yourDataText1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "... und deswegen sammelt und speichert die App absolut keine persönlichen Daten von dir aus deinem iPhone, weder in der App, noch auf irgendeinem Server. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "... and that's why the app doesn't store any personal data, neither in the app nor on any server. "
          }
        }
      }
    },
    "yourDataText2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit einem Klick auf „In 'Fotos' App speichern“ wird lediglich ein Foto von dem QR Code in der 'Fotos' App gespeichert (alternativ geht natürlich auch ein Screenshot) und der codierte Text wird einer Liste (Verlauf) hinzugefügt, damit er unter \"Mein Verlauf\" wieder gefunden und wieder verwendet werden kann. Diese List befindet sich auf deinem Telefon und wird nicht auf einem Server gespeichert. Die Einträge der Liste können individuell gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A click on \"Save to 'Photos' App\", saves a picture of the QR code in the 'Photos' app (alternatively, a screenshot is also possible) and the encoded text is added to a list (history) so that it can be found and used again under \"My History\". This list is on your phone and is not saved on a server. The entries in the list can be deleted individually."
          }
        }
      }
    },
    "yourDataTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Daten sind mir egal ..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I don't care about your data..."
          }
        }
      }
    }
  },
  "version" : "1.0"
}