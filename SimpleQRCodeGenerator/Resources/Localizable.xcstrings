    "update2Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Mein Verlauf“ können die Texte von bis zu 100 der letzten gespeicherten Codes nachgeschaut werden. Die Texte können per Klick in das Textfeld übernommen, bei Bedarf bearbeitet und als neues Bild in die Fotos App gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under \"My History\" you can now view the texts of up to 100 of the most recently saved codes. The texts can be copied into the text field by clicking on them, edited if necessary and saved as a new image in the 'Photos' app."
          }
        }
      }
    },
