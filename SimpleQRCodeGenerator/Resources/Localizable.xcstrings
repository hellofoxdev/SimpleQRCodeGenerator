    "yourDataText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "... und deswegen speichert die App absolut keine persönlichen Daten, weder in der App, noch auf irgendeinem Server. Lediglich ein Foto von dem QR Code wird in der 'Fotos' App abgelegt, wenn es gewollt ist (ein Screenshot geht natürlich auch)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "... and that's why the app doesn't store any personal data, neither in the app nor on any server. Only a photo of the QR code is saved in the 'Photos' app if you want it (a screenshot is also possible, of course)."
          }
        }
      }
