    "freeText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App ist vollkommen kostenfrei. Das bedeutet, sie ist kostenfrei im AppStore, es gibt keine In-App-Käufe, es gibt keine Werbung und - wie oben beschrieben - ich sammle keine Daten und verarbeite oder verkaufe sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is completely free. This means it is free in the AppStore, there are no in-app purchases, there is no advertising and - as described above - I do not collect, process or sell any personal data."
          }
        }
      }
    },
    "information" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Über die App"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About the App"
          }
        }
      }
    },
    "instructionsSavedCodesTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was ist „Mein Verlauf“?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What’s \"My History\"?"
          }
        }
      }
    },
    "instructionsText1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schreibe den Text, den du im QR Code codiert haben möchtest, in das Textfeld. Der QR Code ändert sich direkt während der Eingabe. Solange kein Text eingegeben wurde, ist der QR Code dunkel und kann nicht als Foto gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the text you want to have encoded in the QR code into the text field. The QR code changes as you type. As long as no text has been entered, the QR code is dark and cannot be saved as a photo."
          }
        }
      }
    },
    "instructionsText2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit einem Klick auf „In 'Fotos' App speichern“ passiert genau das was drauf steht, der QR Code wird so wie er ist, als Bild, in der 'Fotos' App abgelegt, von dort aus kannst du ihn per Mail, iMessage, WhatsApp oder was auch immer verschicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you click the \"Save to 'Photos' App\" button, exactly what it is supposed to do happens: the QR code is saved as it is, as an image, in the 'Photos' app. From there you can send it by email, iMessage, WhatsApp or whatever."
          }
        }
      }
    },
    "instructionsText3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unter „Mein Verlauf“ findest du bis zu 100 deiner zuletzt erstellen QR Codes.  Mit einem Klick auf den Eintrag, wird das Textfeld automatisch mit dem jeweiligen Text gefüllt. Nun kannst du den QR Code erneut als Foto speichern. Wenn nötig kannst du natürlich noch Anpassungen vorher machen. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under \"My History\" you will find up to 100 of your most recently created QR codes. If you click on the entry, the text field is automatically filled with the relevant text. You can now save the QR code again as a photo. If necessary, you can of course make adjustments beforehand."
          }
        }
      }
    },
    "instructionsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was musst du machen, um deinen QR Code zu erhalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do you have to do to get your QR code?"
          }
        }
      }
    },
