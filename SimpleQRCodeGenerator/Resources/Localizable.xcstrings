            "value" : ". Einem QR Code Generator, der genau das macht, was er soll, nicht mehr und nicht weniger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". A QR code generator that does exactly what it's supposed to, no more and no less."
          }
        }
      }
    },
