      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ich habe keine Interesse an deinen Daten, weder zur Verarbeitung, noch zum Verkauf. Deswegen sammelt die App auch keinerlei persönliche Daten von dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have no interest in your data, neither for processing nor for selling. That's why the app does not collect any personal data from you."
